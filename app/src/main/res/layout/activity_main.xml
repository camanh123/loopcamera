<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera Loop 30"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tối đa 30 video timestamp trên USB/DCIM/Camera. Không rename."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="USB/DCIM: (chưa chọn)"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChooseFolder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent"
            android:text="CHỌN THƯ MỤC"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUsbProbe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/warn"
            android:text="USB PRIVATE STORAGE PROBE"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CHỈ KIỂM TRA — KHÔNG XÓA VIDEO / KHÔNG ĐỔI PRODUCTION"
            android:textColor="@color/warn"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProbeVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="PROBE: chưa chạy"
            android:textColor="@color/warn"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProbeReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:minHeight="280dp"
            android:padding="10dp"
            android:text="Bấm USB PRIVATE STORAGE PROBE. Kết quả hiện ở đây (không cần ADB)."
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyProbe"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="COPY DIAGNOSTIC REPORT"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExportProbe"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="EXPORT DIAGNOSTIC REPORT"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Status:\nWaiting for USB"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Video count: 0 / 30"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mode: TEST MODE"
            android:textColor="@color/test"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestMode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="TEST MODE"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnLoopMode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="LOOP MODE"
                android:textColor="@color/text" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStopLoop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/error"
            android:text="STOP LOOP"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtFailsafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface"
            android:padding="10dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClearFailsafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ĐÃ KIỂM TRA / XÓA FAILSAFE"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TEST MODE"
            android:textColor="@color/test"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không xóa / không rename / không sửa file. Chỉ mô phỏng."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Newest: —"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtOldest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Oldest: —"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtFileState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Current state: —"
            android:textColor="@color/warn"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="Predicted action: —"
            android:textColor="@color/warn"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:minHeight="220dp"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
