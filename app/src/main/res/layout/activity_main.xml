<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera Loop 10"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Loop tối đa 10 video trên USB/DCIM (Android 10, không root)"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="USB/DCIM: (chưa chọn)"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChooseFolder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent"
            android:text="CHỌN THƯ MỤC"
            android:textColor="#FF111111"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Status:\nUSB/DCIM: Not connected"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Video count: 0 / 10"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mode: TEST MODE"
            android:textColor="@color/test"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestMode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="TEST MODE"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnLoopMode"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="LOOP MODE"
                android:textColor="@color/text" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStopLoop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/error"
            android:text="STOP LOOP"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtFailsafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface"
            android:padding="10dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClearFailsafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ĐÃ KIỂM TRA / XÓA FAILSAFE"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TEST MODE"
            android:textColor="@color/test"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không xóa file. Chỉ mô phỏng thao tác."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Video mới nhất: —"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtOldest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Video cũ nhất: —"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="Thao tác dự kiến: —"
            android:textColor="@color/warn"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:minHeight="220dp"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
